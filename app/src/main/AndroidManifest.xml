<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Add internet permission for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".NutriTrackApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NutriTrack"
        tools:targetApi="31">

        <!-- Keep your actual activities -->
        <activity
            android:name=".NutriTrackBottomNavigation"
            android:exported="false"
            android:label="@string/title_activity_nutri_track_bottom_navigation"
            android:theme="@style/Theme.NutriTrack" />

        <activity
            android:name=".InsightsActivity"
            android:exported="false"
            android:label="@string/title_activity_insights"
            android:theme="@style/Theme.NutriTrack" />

        <activity
            android:name=".QuestionnaireActivity"
            android:exported="false"
            android:label="@string/title_activity_questionnaire"
            android:theme="@style/Theme.NutriTrack" />

        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:label="@string/title_activity_home_screen"
            android:theme="@style/Theme.NutriTrack" />

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="@string/title_activity_login"
            android:theme="@style/Theme.NutriTrack" />

        <!-- Add missing activities -->
        <activity
            android:name=".NutriCoachActivity"
            android:exported="false"
            android:label="NutriCoach"
            android:theme="@style/Theme.NutriTrack" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:theme="@style/Theme.NutriTrack" />

        <activity
            android:name=".ClinicianDashboardActivity"
            android:exported="false"
            android:label="Admin Analytics"
            android:theme="@style/Theme.NutriTrack" />

        <!-- Main launcher activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NutriTrack">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>